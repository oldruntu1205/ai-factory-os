        }
      }
    },
    {
      "if": {
        "properties": {
          "service_id": {
            "const": "hermes-runtime"
          }
        },
        "required": [
          "service_id"
        ]
      },
      "then": {
        "properties": {
          "owned_schema": {
            "const": "runtime"
          },
          "migration_directory": {
            "const": "migrations/runtime/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_id": {
            "const": "manufacturing-core"
          }
        },
        "required": [
          "service_id"
        ]
      },
      "then": {
        "properties": {
          "owned_schema": {
            "const": "manufacturing"
          },
          "migration_directory": {
            "const": "migrations/manufacturing/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_id": {
            "const": "tool-gateway"
          }
        },
        "required": [
          "service_id"
        ]
      },
      "then": {
        "properties": {
          "owned_schema": {
            "const": "tools"
          },
          "migration_directory": {
            "const": "migrations/tools/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_id": {
            "const": "transaction-service"
          }
        },
        "required": [
          "service_id"
        ]
      },
      "then": {
        "properties": {
          "owned_schema": {
            "const": "transaction"
          },
          "migration_directory": {
            "const": "migrations/transaction/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_id": {
            "const": "trajectory-eval"
          }
        },
        "required": [
          "service_id"
        ]
      },
      "then": {
        "properties": {
          "owned_schema": {
            "const": "evidence"
          },
          "migration_directory": {
            "const": "migrations/evidence/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {
            "const": "production"
          }
        },
        "required": [
          "environment"
        ]
      },
      "then": {
        "properties": {
          "availability_profile": {
            "properties": {
              "production_slo_ref": {
                "$ref": "common-context.json#/$defs/Identifier"
              }
            }
          }
        }
      }
    }
  ],
  "examples": [
