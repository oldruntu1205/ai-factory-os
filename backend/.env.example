# ===== 工业 AI 员工平台 环境配置示例 =====
# 复制为 .env 并修改后生效（或用环境变量注入）

# ---------- 数据库 ----------
# 生产（Docker）：不要设 USE_SQLITE，由 docker-compose 注入 DATABASE_URL 即可
# 本地快速开发：取消下面两行注释用 SQLite
# USE_SQLITE=1
# SQLITE_PATH=./industrial_ai.db
# 显式指定 PostgreSQL（设了它，USE_SQLITE 自动失效）：
# DATABASE_URL=postgresql://industrial:yourpassword@localhost:5432/industrial_ai

# ---------- JWT ----------
SECRET_KEY=please-change-this-secret-key-in-production

# ---------- LLM 网关（默认 DeepSeek）----------
# gateway 可选: deepseek(默认) / fireworks / openai / zhipu / dashscope / ollama
LLM_GATEWAY=deepseek
# DeepSeek API Key（platform.deepseek.com 获取）
LLM_API_KEY=
# 模型: deepseek-chat（V3 通用） / deepseek-reasoner（R1 深度推理）
LLM_MODEL=deepseek-chat

# Fireworks AI（落地手册模型推理层，切换 gateway=fireworks 时使用）
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# ---------- Qdrant ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=company_docs

# ---------- WhatsApp ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=verify_token
WHATSAPP_APP_SECRET=          # Meta App Secret（webhook 签名校验，可选）

# ---------- 企业微信 ----------
# 群机器人（推送 AI 日报/报价到企微群）
WECOM_ROBOT_KEY=
# 自建应用（客户消息回调 -> AI 员工回复）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=                  # 回调 Token（明文模式）
WECOM_AES_KEY=                # 回调 EncodingAESKey（明文模式可空）

# ---------- 邮件 SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sales@company.com

# ---------- Redis / RabbitMQ / Celery ----------
REDIS_URL=redis://localhost:6379/0
# 队列模式: auto(自动探测: rabbitmq→redis→内存) / rabbitmq / redis / memory
QUEUE_MODE=auto
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
