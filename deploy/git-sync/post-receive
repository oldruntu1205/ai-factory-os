#!/bin/bash
# ============================================================
# 生产部署钩子：post-receive
# 由 deploy/git-sync/setup-prod.sh 安装到 bare 仓库 hooks/ 下。
#
# 行为：
#   收到 git push 后，将代码检出(checkout -f)到 $WORK_TREE；
#   仅当 backend/ 目录有变更时重启后端服务（带语法预检，防止坏代码导致全站 500）。
#   若推送不含后端变更，仅检出代码、不重启，避免无谓中断。
#
# 配置来自同仓库的 deploy-config.sh（由 setup-prod.sh 生成）。
# ============================================================
set -uo pipefail

# 定位 bare 仓库根目录（本文件位于 $GIT_DIR/hooks/post-receive）
GIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# 读取部署配置（setup-prod.sh 生成）；缺省给兜底值
CONFIG="$GIT_DIR/deploy-config.sh"
if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  source "$CONFIG"
fi
WORK_TREE="${WORK_TREE:-/www/wwwroot/<站点目录>}"
BRANCH="${BRANCH:-main}"
SERVICES="${SERVICES:-ai-factory-backend ai-factory-worker}"

# 优先用后端 venv 的 python 做语法预检；缺失则回退系统 python3
PY="${PY:-$WORK_TREE/backend/venv/bin/python}"
if [ ! -x "$PY" ]; then
  PY="$(command -v python3 || true)"
fi

changed_backend=0
while read oldrev newrev ref; do
  [ "$ref" = "refs/heads/$BRANCH" ] || continue
  git --work-tree="$WORK_TREE" --git-dir="$GIT_DIR" checkout -f "$BRANCH"

  # 首次推送 oldrev 为全 0，diff 会列出全部文件；只要存在 backend/ 文件即视为有变更
  if git diff --name-only "$oldrev" "$newrev" 2>/dev/null | grep -q '^backend/'; then
    changed_backend=1
  fi
done

if [ "$changed_backend" = "1" ]; then
  # 语法预检：失败则保留旧服务运行，不重启，避免全站 500
  mapfile -t py_files < <(find "$WORK_TREE/backend" -name '*.py' -not -path '*/venv/*' 2>/dev/null)
  if [ "${#py_files[@]}" -gt 0 ] && [ -n "$PY" ] && ! "$PY" -m py_compile "${py_files[@]}" 2>/dev/null; then
    echo "[deploy] $(date '+%F %T') 语法检查失败，已中止重启，旧服务继续运行" >> "$WORK_TREE/deploy.log"
    exit 0
  fi
  # shellcheck disable=SC2086
  systemctl restart $SERVICES
  echo "[deploy] $(date '+%F %T') backend 已同步并重启: $SERVICES" >> "$WORK_TREE/deploy.log"
else
  echo "[deploy] $(date '+%F %T') 推送不含后端变更，仅检出代码（未重启）" >> "$WORK_TREE/deploy.log"
fi
