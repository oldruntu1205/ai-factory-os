# ============================================================
# 生产环境变量模板（部署脚本会复制为项目根目录 .env）
# docker compose 自动读取本文件做变量插值
# 请逐项修改为真实值，尤其是带 < > 占位符的敏感项
# ============================================================

# ---- JWT 签名密钥（务必改成随机强密钥，可用: openssl rand -hex 32）----
SECRET_KEY=<请替换为随机字符串，例如 openssl rand -hex 32 的输出>

# ---- 演示种子数据：生产环境关闭（0），避免自动注入演示企业/AI 员工 ----
SEED_DEMO=0

# ---- 公网可访问地址（邮件追踪像素 / 退订页 / Webhook 回调基址）----
APP_PUBLIC_URL=https://api.yourdomain.com

# ---- 队列模式: auto(自动探测 rabbitmq→redis→内存) / rabbitmq / redis / memory ----
QUEUE_MODE=auto

# ---- LLM 网关（默认 deepseek；可选 fireworks / openai / zhipu / dashscope / ollama）----
LLM_GATEWAY=deepseek
LLM_MODEL=deepseek-chat
# DeepSeek API Key（platform.deepseek.com 获取）
LLM_API_KEY=<填入你的 DeepSeek API Key>

# Fireworks（gateway=fireworks 时使用）
FIREWORKS_API_KEY=

# 向量 Embedding 模型（如用本地/离线模型可改）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---- 以下为可选渠道，按业务开启 ----
# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=verify_token
# 企业微信
WECOM_ROBOT_KEY=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
# 邮件 SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sales@yourdomain.com

# ---- 自进化调度器（GEPA 周期自进化）----
# 默认关闭：上线不自动跑 GEPA，避免即时消耗 LLM；确认无误后改 1 开启
EVOLUTION_SCHEDULER_ENABLED=0
# 周期秒，默认 24h
EVOLUTION_SCHEDULER_INTERVAL=86400
# 启动延迟秒，默认 300s
EVOLUTION_SCHEDULER_START_DELAY=300
# 回溯天数，默认 30
EVOLUTION_SCHEDULER_LOOKBACK_DAYS=30
# 进化目标类型，默认 soul,skill
EVOLUTION_SCHEDULER_TARGET_TYPES=soul,skill
