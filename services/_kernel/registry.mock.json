      "policy_version": "policy-demo",

      "_comment_reason_codes": "策略判定自己的原因码目录。**为什么不复用 decision_catalog.reason_codes**：契约把 `reason_code` 声明为 `CatalogValue`（`x-catalog-required: true`，须取自有限目录），而策略判定与任务路由是**两类不同的决策**；共用一个目录会让'这条判定属于谁'在审计时无法区分，也会让一边扩目录时意外放宽另一边。",
      "reason_codes": {
        "allowed": "policy-auto-execute-allowed",
        "approval_required": "policy-approval-required",
        "denied": "policy-auto-execute-denied"
      },

      "risk_rules": {
        "R0": { "requires_approval": false, "auto_execute": true },
        "R1": { "requires_approval": false, "auto_execute": true },
        "R2": { "requires_approval": true, "auto_execute": false },
        "R3": { "requires_approval": true, "auto_execute": false }
      }
    }
